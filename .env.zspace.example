# 小智后台生成的完整 WebSocket 接入地址
XIAOZHI_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=replace-me

# 保护内部报价工具的独立随机密钥
MCP_TOKEN=replace-with-a-long-random-secret

# 极空间局域网管理页面端口
XIAOZHI_WEB_PORT=9999

# 极空间定时从 GitHub 同步数据
GIT_REPO_URL=https://github.com/Sggg5/xiaozhi-internal-mcp.git
GIT_BRANCH=main
SYNC_INTERVAL_SECONDS=3600
